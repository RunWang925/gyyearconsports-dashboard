<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>DashboardKiosk</AssemblyName>
    <RootNamespace>DashboardKiosk</RootNamespace>
    <Version>2.2.1</Version>
    <AssemblyTitle>贵渝意尔康体育数据大屏</AssemblyTitle>
    <Product>贵渝意尔康体育数据大屏</Product>
    <Company>Run</Company>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <!-- dist 目录是交付产物/资料包，不参与编译 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);dist\**</DefaultItemExcludes>
    <!-- 默认嵌入项目根目录的 icon_cockpit.ico（exe 图标/任务栏图标/快捷方式图标都来自它）；
         发布时可通过 -p:IconFile=xxx.ico 覆盖 -->
    <ApplicationIcon Condition="'$(IconFile)' != ''">$(IconFile)</ApplicationIcon>
    <ApplicationIcon Condition="'$(IconFile)' == ''">icon_cockpit.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

</Project>
